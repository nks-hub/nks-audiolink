<Window x:Class="NksAudioLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NKS AudioLink" Width="920" Height="930"
        MinWidth="730" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#111827"
        Foreground="#F3F6FC" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#AAB7C9"/>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#26354A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#40516A"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#26354A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#40516A"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#26354A"/><Setter Property="Foreground" Value="#111827"/><Setter Property="Padding" Value="7"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Background" Value="#344862"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E7EDF7"/><Setter Property="Margin" Value="0,5,20,5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CAD5E6"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B293C"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="19"/><Setter Property="Margin" Value="0,0,0,13"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,24,28,20" MaxWidth="1000">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="NKS AudioLink" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Zvuk z tohoto počítače na vzdálenou zvukovku" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#1B403B" CornerRadius="16" Padding="14,8" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Odpojeno" Foreground="#8DE8BA" FontWeight="SemiBold"/></Border>
      </Grid>
      <Border x:Name="ServerCard" Grid.Row="1" Style="{StaticResource Card}">
        <StackPanel><TextBlock Text="SERVER" FontSize="12" FontWeight="Bold" Foreground="#67D9C6" Margin="0,0,0,13"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Adresa nebo název" Style="{StaticResource Label}"/><TextBox x:Name="ServerBox" Text="127.0.0.1"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="UDP port" Style="{StaticResource Label}"/><TextBox x:Name="PortBox" Text="7355"/></StackPanel>
            <Button Grid.Column="2" x:Name="DiscoverButton" Content="Najít" VerticalAlignment="Bottom" Click="Discover_Click"/>
          </Grid>
          <TextBlock x:Name="DiscoveryText" Text="Zadejte adresu nebo najděte server v místní síti." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
          <StackPanel Margin="0,12,0,0"><TextBlock Text="Sdílený klíč (Base64, pokud je vyžadován)" Style="{StaticResource Label}"/><PasswordBox x:Name="PskBox"/></StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="SourceCard" Grid.Row="2" Style="{StaticResource Card}">
        <StackPanel><TextBlock Text="ZDROJ ZVUKU" FontSize="12" FontWeight="Bold" Foreground="#67D9C6" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal"><RadioButton x:Name="LoopbackRadio" GroupName="Mode" Content="Celý zvuk PC" IsChecked="True" Checked="Mode_Checked"/><RadioButton x:Name="VirtualRadio" GroupName="Mode" Content="Virtuální zvukovka" Checked="Mode_Checked"/><RadioButton x:Name="CaptureRadio" GroupName="Mode" Content="Jiný vstup" Checked="Mode_Checked"/></StackPanel>
          <TextBlock x:Name="ModeDescription" Text="Odesílá zvuk vybraného výstupu. Současně hraje i na PC." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" SelectedValuePath="Id" MinHeight="39"/><Button Grid.Column="1" Content="Obnovit" Margin="12,0,0,0" Click="RefreshDevices_Click"/></Grid>
          <TextBlock x:Name="DeviceHint" Foreground="#F7CC88" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
          <Button x:Name="CableInfoButton" Content="Web VB-CABLE" HorizontalAlignment="Left" Margin="0,9,0,0" Visibility="Collapsed" Click="CableInfo_Click"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="3" Style="{StaticResource Card}">
        <StackPanel><TextBlock Text="PŘENOS" FontSize="12" FontWeight="Bold" Foreground="#67D9C6" Margin="0,0,0,13"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,25,0"><DockPanel><TextBlock Text="Zesílení" Style="{StaticResource Label}"/><TextBlock x:Name="GainValue" Text="100 %" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="GainSlider" Minimum="0" Maximum="200" Value="100" TickFrequency="5" ValueChanged="GainSlider_Changed"/></StackPanel>
            <StackPanel Grid.Column="1"><DockPanel><TextBlock Text="Cílový buffer" Style="{StaticResource Label}"/><TextBlock x:Name="LatencyValue" Text="30 ms" HorizontalAlignment="Right"/></DockPanel><Slider x:Name="LatencySlider" Minimum="10" Maximum="200" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="LatencySlider_Changed"/></StackPanel>
          </Grid>
          <TextBlock Text="Zesílení se mění okamžitě. Buffer nastavte před připojením." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="4">
        <Grid Margin="0,2,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="StartWithWindowsCheck" Content="Spouštět s Windows" VerticalAlignment="Center" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
          <Button x:Name="ConnectButton" Grid.Column="1" Content="Připojit" Background="#157F75" FontWeight="SemiBold" FontSize="15" Click="Connect_Click"/>
        </Grid>
        <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="ŽIVÝ STAV" FontSize="12" FontWeight="Bold" Foreground="#67D9C6" Margin="0,0,0,15"/>
          <UniformGrid Columns="4"><StackPanel><TextBlock Text="Latence odhad" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="EndToEndText" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel>
            <StackPanel><TextBlock Text="Buffer serveru" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="BufferText" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel>
            <StackPanel><TextBlock Text="ALSA delay" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="SinkDelayText" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel>
            <StackPanel><TextBlock Text="RTT" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="RttText" Text="—" FontSize="21" FontWeight="SemiBold"/></StackPanel></UniformGrid>
          <UniformGrid Columns="4" Margin="0,16,0,0"><StackPanel><TextBlock Text="Ztráty" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="LostText" Text="—" FontSize="18"/></StackPanel>
            <StackPanel><TextBlock Text="Pozdní rámce" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="LateText" Text="—" FontSize="18"/></StackPanel>
            <StackPanel><TextBlock Text="Podtečení" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="UnderrunText" Text="—" FontSize="18"/></StackPanel>
            <StackPanel><TextBlock Text="Přetečení" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="OverrunText" Text="—" FontSize="18"/></StackPanel></UniformGrid>
          <TextBlock x:Name="DetailText" Text="Připraveno k připojení." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel></Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
